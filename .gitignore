# ===== Local configuration (contains secrets) =====
config.local.php
config.local.demo.php
www/config.local.php

# ===== RSA keys for JWT signing =====
keys/

# ===== Application logs =====
# Ignore the log files themselves, but keep the directory's deny-all .htaccess
# under version control so it ships with the code.
www/logs/*
!www/logs/.htaccess
*.log

# ===== Image / file cache =====
/cache/

# ===== Vim temporary files =====
*.swp
*.swo
*.swn
*~

# ===== macOS =====
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ===== PHP =====
*.phar
!unit-tests/tools/phpunit.phar
unit-tests/.phpunit.cache/
www/unit-tests/.phpunit.cache/
www/unit-tests/tests/tmp/

# ===== Python =====
__pycache__/
*.pyc
*.pyo
*.pyd

# ===== Runtime (never commit logs or caches) =====
www/cache/*
!www/cache/.htaccess
var/

xcschememanagement.plist
secret/
db_backups/

# ===== Swift Package Manager / Xcode (also covered by ios/.gitignore) =====
.build/
.swiftpm/
DerivedData/
